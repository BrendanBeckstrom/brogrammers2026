{
  "kind": "Dashboard",
  "metadata": {
    "name": "debrief-health"
  },
  "spec": {
    "duration": "6h",
    "refreshInterval": "1m",
    "display": {
      "name": "Debrief health",
      "description": "Playlist latency and coverage, API traffic, memo citations, LLM tokens and browser RUM for Debrief."
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Playlists"
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/playlist_latency"
              }
            },
            {
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/playlist_under_5s"
              }
            },
            {
              "x": 0,
              "y": 8,
              "width": 24,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/coverage_gaps"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "What teams ask for"
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/tool_requests"
              }
            },
            {
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/clip_labels"
              }
            },
            {
              "x": 0,
              "y": 8,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/playlists_shared"
              }
            },
            {
              "x": 12,
              "y": 8,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/cache_lookups"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "API"
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/request_rate"
              }
            },
            {
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/error_rate"
              }
            },
            {
              "x": 0,
              "y": 8,
              "width": 24,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/http_requests_by_status"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Memo and model"
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/citations_dropped"
              }
            },
            {
              "x": 8,
              "y": 0,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/memo_lines_valid"
              }
            },
            {
              "x": 16,
              "y": 0,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/llm_tokens"
              }
            },
            {
              "x": 0,
              "y": 8,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/rerank_batches"
              }
            },
            {
              "x": 12,
              "y": 8,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/memo_latency"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Browser (RUM)"
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/watch_clicks_by_rank"
              }
            },
            {
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/rum_actions"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Event logs"
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 10,
              "content": {
                "$ref": "#/spec/panels/playlist_served_logs"
              }
            }
          ]
        }
      }
    ],
    "panels": {
      "playlist_latency": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Playlist latency p50 / p95 by outcome",
            "description": "debrief.playlist.duration (ms), split by outcome (ok, empty, error)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom"
              },
              "yAxis": {
                "min": 0,
                "format": {
                  "unit": "milliseconds"
                }
              },
              "visual": {
                "display": "line"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum by (outcome) (rate({otel_metric_name=\"debrief.playlist.duration\", otel_metric_type=\"histogram\"}[$__rate_interval])))",
                    "seriesNameFormat": "p95 {{outcome}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.50, sum by (outcome) (rate({otel_metric_name=\"debrief.playlist.duration\", otel_metric_type=\"histogram\"}[$__rate_interval])))",
                    "seriesNameFormat": "p50 {{outcome}}"
                  }
                }
              }
            }
          ]
        }
      },
      "playlist_under_5s": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Playlists under 5 s (SLO objective 95%)",
            "description": "Share of /api/playlist requests that finished in under 5 s. 5000 ms is a histogram bucket boundary, so this is exact."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom"
              },
              "yAxis": {
                "min": 0,
                "max": 100,
                "format": {
                  "unit": "percent"
                }
              },
              "visual": {
                "display": "line"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "100 * histogram_fraction(0, 5000, sum by (deployment_environment_name) (rate({otel_metric_name=\"debrief.playlist.duration\", otel_metric_type=\"histogram\"}[$__rate_interval])))",
                    "seriesNameFormat": "under 5 s ({{deployment_environment_name}})"
                  }
                }
              }
            }
          ]
        }
      },
      "coverage_gaps": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Coverage gaps (empty playlists by tool)",
            "description": "debrief.playlist.empty. Each empty playlist counts once per requested tool; tools outside the catalog show as \"other\"."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "right"
              },
              "yAxis": {
                "min": 0
              },
              "visual": {
                "display": "bar"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (tool) (increase({otel_metric_name=\"debrief.playlist.empty\", otel_metric_type=\"sum\"}[$__rate_interval]))",
                    "seriesNameFormat": "{{tool}}"
                  }
                }
              }
            }
          ]
        }
      },
      "request_rate": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "API request rate by route (req/s)",
            "description": "Server spans of debrief-api (Dash0 span metric dash0.spans). Probes are not traced."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "right"
              },
              "yAxis": {
                "min": 0
              },
              "visual": {
                "display": "line"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (http_route) (rate({otel_metric_name=\"dash0.spans\", service_name=\"debrief-api\", otel_span_kind=\"SERVER\"}[$__rate_interval]))",
                    "seriesNameFormat": "{{http_route}}"
                  }
                }
              }
            }
          ]
        }
      },
      "error_rate": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "API error rate (%)",
            "description": "Server spans with status ERROR (5xx) over all server spans of debrief-api."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom"
              },
              "yAxis": {
                "min": 0,
                "format": {
                  "unit": "percent"
                }
              },
              "visual": {
                "display": "line"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "100 * (sum(rate({otel_metric_name=\"dash0.spans\", service_name=\"debrief-api\", otel_span_kind=\"SERVER\", otel_span_status_code=\"ERROR\"}[$__rate_interval])) or vector(0)) / sum(rate({otel_metric_name=\"dash0.spans\", service_name=\"debrief-api\", otel_span_kind=\"SERVER\"}[$__rate_interval]))",
                    "seriesNameFormat": "error %"
                  }
                }
              }
            }
          ]
        }
      },
      "citations_dropped": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Memo lines dropped (no valid citation)",
            "description": "debrief.memo.citations_dropped by reason (uncited, unknown_clip, other). Empty means nothing was dropped."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom"
              },
              "yAxis": {
                "min": 0
              },
              "visual": {
                "display": "bar"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (reason) (increase({otel_metric_name=\"debrief.memo.citations_dropped\", otel_metric_type=\"sum\"}[$__rate_interval]))",
                    "seriesNameFormat": "{{reason}}"
                  }
                }
              }
            }
          ]
        }
      },
      "memo_lines_valid": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Memo lines with a valid citation (SLO objective 99%)",
            "description": "1 - debrief.memo.citations_dropped / debrief.memo.lines."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom"
              },
              "yAxis": {
                "min": 0,
                "max": 100,
                "format": {
                  "unit": "percent"
                }
              },
              "visual": {
                "display": "line"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "100 * (1 - ((sum(increase({otel_metric_name=\"debrief.memo.citations_dropped\", otel_metric_type=\"sum\"}[$__rate_interval])) or vector(0)) / sum(increase({otel_metric_name=\"debrief.memo.lines\", otel_metric_type=\"sum\"}[$__rate_interval]))))",
                    "seriesNameFormat": "valid %"
                  }
                }
              }
            }
          ]
        }
      },
      "llm_tokens": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "LLM tokens by purpose",
            "description": "debrief.llm.tokens (input + output) by purpose (rerank, memo, label)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom"
              },
              "yAxis": {
                "min": 0
              },
              "visual": {
                "display": "bar"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (purpose) (increase({otel_metric_name=\"debrief.llm.tokens\", otel_metric_type=\"sum\"}[$__rate_interval]))",
                    "seriesNameFormat": "{{purpose}}"
                  }
                }
              }
            }
          ]
        }
      },
      "watch_clicks_by_rank": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Watch clicks by playlist rank (RUM)",
            "description": "Dash0 web events named watch_click from debrief-web, grouped by the rank attribute (1 = top clip)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "right"
              },
              "yAxis": {
                "min": 0
              },
              "visual": {
                "display": "bar"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (rank) (increase({otel_metric_name=\"dash0.web.events\", service_name=\"debrief-web\", event_name=\"watch_click\"}[$__rate_interval]))",
                    "seriesNameFormat": "rank {{rank}}"
                  }
                }
              }
            }
          ]
        }
      },
      "rum_actions": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Product actions in the browser (RUM)",
            "description": "Custom web events from debrief-web, by name."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "right"
              },
              "yAxis": {
                "min": 0
              },
              "visual": {
                "display": "bar"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (event_name) (increase({otel_metric_name=\"dash0.web.events\", service_name=\"debrief-web\", event_name=~\"playlist_build|watch_click|memo_make|memo_copy\"}[$__rate_interval]))",
                    "seriesNameFormat": "{{event_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "tool_requests": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Most requested tools (top 10)",
            "description": "debrief.playlist.tool_requests by tool. Each playlist counts each requested tool once; ids outside the catalog show as \"other\"."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "right"
              },
              "yAxis": {
                "min": 0
              },
              "visual": {
                "display": "bar",
                "stack": "all"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "topk(10, sum by (tool) (increase({otel_metric_name=\"debrief.playlist.tool_requests\", otel_metric_type=\"sum\"}[$__rate_interval])))",
                    "seriesNameFormat": "{{tool}}"
                  }
                }
              }
            }
          ]
        }
      },
      "clip_labels": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Clip label mix",
            "description": "debrief.playlist.clip_labels. Every clip served, by its talk's label (deep_dive, intro, pitch, unlabelled)."
          },
          "plugin": {
            "kind": "PieChart",
            "spec": {
              "calculation": "sum"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (label) (increase({otel_metric_name=\"debrief.playlist.clip_labels\", otel_metric_type=\"sum\"}[$__rate_interval]))",
                    "seriesNameFormat": "{{label}}"
                  }
                }
              }
            }
          ]
        }
      },
      "playlists_shared": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Playlists shared",
            "description": "debrief.playlists.shared. One per POST /api/playlists that saved a shareable link."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom"
              },
              "yAxis": {
                "min": 0
              },
              "visual": {
                "display": "bar"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(increase({otel_metric_name=\"debrief.playlists.shared\", otel_metric_type=\"sum\"}[$__rate_interval]))",
                    "seriesNameFormat": "shared"
                  }
                }
              }
            }
          ]
        }
      },
      "cache_lookups": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Demo cache lookups by route and result",
            "description": "debrief.cache.lookups. Only recorded with DEBRIEF_CACHE=on, so empty means the cache is off."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "right"
              },
              "yAxis": {
                "min": 0
              },
              "visual": {
                "display": "bar",
                "stack": "all"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (route, result) (increase({otel_metric_name=\"debrief.cache.lookups\", otel_metric_type=\"sum\"}[$__rate_interval]))",
                    "seriesNameFormat": "{{route}} {{result}}"
                  }
                }
              }
            }
          ]
        }
      },
      "http_requests_by_status": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HTTP requests by route and status (req/s)",
            "description": "http.server.duration from the FastAPI instrumentation (probes excluded), counted per route template (http.target) and status code."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "right"
              },
              "yAxis": {
                "min": 0
              },
              "visual": {
                "display": "line"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (http_target, http_status_code) (histogram_count(rate({otel_metric_name=\"http.server.duration\", otel_metric_type=\"histogram\", service_name=\"debrief-api\"}[$__rate_interval])))",
                    "seriesNameFormat": "{{http_target}} {{http_status_code}}"
                  }
                }
              }
            }
          ]
        }
      },
      "rerank_batches": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Rerank batch outcomes",
            "description": "debrief.rerank.batches by outcome (ok, fallback for a model error or unusable reply, timeout). A failed batch keeps template why lines for its clips only."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom"
              },
              "yAxis": {
                "min": 0
              },
              "visual": {
                "display": "bar",
                "stack": "all"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (outcome) (increase({otel_metric_name=\"debrief.rerank.batches\", otel_metric_type=\"sum\"}[$__rate_interval]))",
                    "seriesNameFormat": "{{outcome}}"
                  }
                }
              }
            }
          ]
        }
      },
      "memo_latency": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Memo latency p50 / p95",
            "description": "debrief.memo.duration (ms) for live memos that succeeded (cached memos are not recorded)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom"
              },
              "yAxis": {
                "min": 0,
                "format": {
                  "unit": "milliseconds"
                }
              },
              "visual": {
                "display": "line"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum(rate({otel_metric_name=\"debrief.memo.duration\", otel_metric_type=\"histogram\", outcome=\"ok\"}[$__rate_interval])))",
                    "seriesNameFormat": "p95"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.50, sum(rate({otel_metric_name=\"debrief.memo.duration\", otel_metric_type=\"histogram\", outcome=\"ok\"}[$__rate_interval])))",
                    "seriesNameFormat": "p50"
                  }
                }
              }
            }
          ]
        }
      },
      "playlist_served_logs": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Playlists served (event=playlist.served)",
            "description": "One structured log per playlist from debrief-api. Ids, counts, rerank status, duration and cache result; never the pain sentence or transcript text."
          },
          "plugin": {
            "kind": "LogTable",
            "spec": {
              "showAttributePreview": true,
              "maxLogEntries": 50,
              "filters": [
                {
                  "key": "service.name",
                  "operator": "is",
                  "value": "debrief-api"
                },
                {
                  "key": "event.name",
                  "operator": "is",
                  "value": "playlist.served"
                }
              ],
              "sort": {
                "sortField": "timestamp",
                "sortDirection": "desc"
              }
            }
          }
        }
      }
    }
  }
}
