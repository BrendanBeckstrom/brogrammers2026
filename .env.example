# Every env var Debrief reads. Copy to .env and fill in; .env is gitignored.
# On the cluster these come from the Kubernetes Secret `app-credentials` instead.

# --- Elastic (ingest, API) ---
# Serverless project endpoint, e.g. https://<project>.es.<region>.gcp.elastic.cloud:443
ELASTIC_URL=
ELASTIC_API_KEY=

# --- Language model (ingest labels, API rerank + memo) ---
# elastic (default: Elastic Inference Service via ELASTIC_URL/ELASTIC_API_KEY, no key here)
# | anthropic | openai — only api/llm.py reads these
LLM_PROVIDER=
# anthropic / openai only
LLM_API_KEY=
# Model ids (elastic: inference ids). Defaults: elastic .anthropic-claude-5-sonnet-completion
# for both; anthropic claude-haiku-5-5 (rerank) and claude-sonnet-5-5 (memo)
LLM_RERANK_MODEL=
LLM_MEMO_MODEL=

# --- Tracing to Dash0 via OpenTelemetry (ingest, API) ---
# e.g. https://ingress.<region>.aws.dash0.com
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
# e.g. Authorization=Bearer%20<dash0-token>,Dash0-Dataset=default (URL-encode spaces; no quotes needed)
OTEL_EXPORTER_OTLP_HEADERS=
# Optional, e.g. deployment.environment=hackathon (defaults: production in Kubernetes, else local)
OTEL_RESOURCE_ATTRIBUTES=
# 1: also print spans, logs and metrics to stderr, one line each (local checks; no endpoint needed)
DEBRIEF_OTEL_CONSOLE=

# --- Demo cache (API) ---
# on: serve cached answers for the golden stacks from api/cache/
DEBRIEF_CACHE=

# --- Build / deploy (API) ---
# The commit's short SHA, set by the image build; defaults to "dev" locally.
APP_VERSION=

# --- Optional path overrides (ingest) ---
# Defaults: data/chunks.jsonl and data/tools.yaml
DEBRIEF_CHUNKS=
DEBRIEF_TOOLS=

# --- Golden stack checks (tests) ---
# API base URL; defaults to http://localhost:8000
DEBRIEF_API_URL=
