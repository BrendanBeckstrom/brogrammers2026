# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Dash0 (OpenTelemetry observability) ---
# Dash0 UI → Settings → Auth Tokens / Endpoints
DASH0_AUTH_TOKEN=
DASH0_OTLP_ENDPOINT=          # e.g. ingress.<region>.aws.dash0.com:4317
DASH0_API_ENDPOINT=           # e.g. https://api.<region>.aws.dash0.com
DASH0_DATASET=default

# Standard OTel SDK vars (apps export to Dash0 directly or via a collector)
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=   # Authorization=Bearer <DASH0_AUTH_TOKEN>

# --- Elasticsearch ---
# Elastic Cloud: Deployment → Manage → Cloud ID; Kibana → Stack Management → API keys
ELASTIC_CLOUD_ID=
ELASTICSEARCH_URL=            # e.g. https://<deployment>.es.<region>.cloud.es.io:443
ELASTIC_API_KEY=

# --- Kubernetes ---
# Cluster access is pending (join code). Point at the kubeconfig once received.
KUBECONFIG=
K8S_NAMESPACE=
